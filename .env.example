# Local OpenAI-compatible endpoint; the current client sends api_key="unused".
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-local-model
REASONING_EFFORT=low

# Set your own API key. Never commit it.
COMPANION_API_AUTH=enforce
COMPANION_API_KEY=
COMPANION_ACTOR_MODE=auto
API_PORT=8788
COMPANION_MCP=1
COMPANION_MCP_KEY=

# Fresh canonical memory; developer databases/state are not distributed.
MEMORY_AUTHORITY=canonical
CANONICAL_RECORD=1
CANONICAL_EXTRACTOR=verbatim
CANONICAL_RERANK=0
CANONICAL_TEMPORAL=1
CANONICAL_ENTITY=1
MEMORY_USER=local-user
MEMORY_AGENT=companion
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIMS=384
EMBED_LAZY=1
EMBED_IDLE_SEC=30
USER_PROFILE=1
HISTORY_LEN=3

# Optional Hermes and Discord. Configure separately.
HERMES_HOME=
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=
BODY_RUN_MODEL=body
BODY_OPS_SESSION=companion-ops
DISCORD_TOKEN=
OWNER_USER_ID=0
NOTIFY_CHANNEL_ID=0

# Optional Codex backend. Enable after setup and connectivity checks.
CODEX_BODY_ENABLED=0
CODEX_APP_SERVER_CMD=
CODEX_BODY_CWD=

OBSIDIAN_VAULT=
OBSIDIAN_MEDIA_DIR=media
OBSIDIAN_SYNC_DIR=companion
CIDER_TOKEN=

# Avoid modifying an existing Hermes setup until configured.
SOUL_SYNC=0
PROFILE_PROVISION=0
SKILLS_EXPORT=0
